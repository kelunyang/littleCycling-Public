node_modules/
dist/
# Build state must not travel with the source: dist/ is ignored, so a tracked
# tsbuildinfo tells a fresh checkout "already built" and `tsc -b` skips emitting.
# Downstream then typechecks against stale or missing .d.ts, and compile-time
# contracts pass VACUOUSLY — that is exactly how the WorldOptions ↔ StyleParams
# assertion was found green while it was in fact checking nothing.
*.tsbuildinfo
**/recordings/*
!**/recordings/.gitkeep
data/*.jsonl
# data/sessions/ 刻意不 ignore：私有 repo 負責在機器間傳遞騎乘紀錄,
# 個資過濾發生在 publish-public.sh(同步到公開 repo 前剝除)
data/*.db
data/*.db-shm
data/*.db-wal
data/config.json
data/routes/*.json
!data/routes/.gitkeep
data/plans/*.json
!data/plans/.gitkeep
data/eurovelo-cache/

# 從 packages/server/ 直接起 server 時會生出的本機資料(config + db),不進版控。
# 上面的 data/* 規則含斜線,只錨定在 repo 根目錄,擋不到這裡。
packages/server/data/

Caddyfile
caddy.exe

# Prevent accidental .js commits in TS source
packages/*/src/**/*.js
packages/*/src/**/*.js.map
.wsl-debug/
.claude/

# MVT survey CSVs are a build product of scripts/mvt-survey/survey.mjs
data/mvt-survey/
